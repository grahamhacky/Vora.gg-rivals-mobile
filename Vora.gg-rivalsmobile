    nm.TextColor3      = T.TEXTD
    nm.TextSize        = 11
    nm.Font            = Enum.Font.Gotham
    nm.TextXAlignment  = Enum.TextXAlignment.Left
    nm.Parent          = nf

    task.delay(3, function()
        TweenService:Create(nf,TweenInfo.new(0.2),{BackgroundTransparency=1}):Play()
        task.wait(0.22)
        nf:Destroy()
    end)
end

