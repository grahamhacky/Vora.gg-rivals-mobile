    row.Parent          = CONTENT
    uc(row, 8)
    tabWidgetOrder[tabName] += 1
    tabPages[tabName][#tabPages[tabName]+1] = row

    local disp = function(v)
        return fmt and string.format(fmt, v) or tostring(v)
    end

    local lbl = Instance.new("TextLabel")
    lbl.Size            = UDim2.new(0.7, 0, 0, 22)
    lbl.Position        = UDim2.new(0,14,0,6)
    lbl.BackgroundTransparency = 1
    lbl.Text            = label
