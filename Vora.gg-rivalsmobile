local hudOrder = 1
local function mkHUDBtn(label, color, onPress)
    local btn = Instance.new("TextButton")
    btn.Size            = UDim2.new(0,48,0,48)
    btn.BackgroundColor3 = T.BG2
    btn.TextColor3      = color or T.TEXT
    btn.Text            = label
    btn.TextSize        = 10
    btn.Font            = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.LayoutOrder     = hudOrder
    btn.Parent          = HUD
    uc(btn, 10)
    us(btn, color or T.ACC2, 1)
    hudOrder += 1

    local function refresh(active)
        TweenService:Create(btn, TweenInfo.new(0.1), {
            BackgroundColor3 = active and (color or T.ACC) or T.BG2
        }):Play()
    end

    btn.MouseButton1Click:Connect(function()
        onPress(btn, refresh)
    end)
    return btn, refresh
end

