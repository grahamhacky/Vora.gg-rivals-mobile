local function addTab(name)
    local btn = Instance.new("TextButton")
    btn.Size            = UDim2.new(0, 70, 0, 32)
    btn.BackgroundColor3 = T.BG3
    btn.TextColor3      = T.TEXTD
    btn.Text            = name
    btn.TextSize        = 12
    btn.Font            = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.LayoutOrder     = tabOrder2
    btn.Parent          = TABSCROLL
    uc(btn, 6)
    tabOrder2 += 1
    tabBtnMap[name] = btn
    tabPages[name]  = {}  -- list of widgets for this tab

    btn.MouseButton1Click:Connect(function()
        selectMTab(name)
    end)
    return name
end

function selectMTab(name)
    -- Hide all widgets
    for tname, widgets in pairs(tabPages) do
        for _, w in ipairs(widgets) do
            w.Visible = (tname == name)
            w.LayoutOrder = w.LayoutOrder  -- preserve order
        end
        tabBtnMap[tname].BackgroundColor3 = T.BG3
        tabBtnMap[tname].TextColor3       = T.TEXTD
    end
    tabBtnMap[name].BackgroundColor3 = T.ACC2
    tabBtnMap[name].TextColor3       = T.TEXT
end

