    lbl.TextSize        = 13
    lbl.Font            = Enum.Font.Gotham
    lbl.TextXAlignment  = Enum.TextXAlignment.Left
    lbl.Parent          = row

    local valLbl = Instance.new("TextLabel")
    valLbl.Size            = UDim2.new(0.3,-14,0,22)
    valLbl.Position        = UDim2.new(0.7,0,0,6)
    valLbl.BackgroundTransparency = 1
    valLbl.Text            = disp(CFG[cfgKey])
    valLbl.TextColor3      = T.ACCH
    valLbl.TextSize        = 13
    valLbl.Font            = Enum.Font.GothamBold
    valLbl.TextXAlignment  = Enum.TextXAlignment.Right
    valLbl.Parent          = row

    -- Tall track for thumb
    local track = Instance.new("Frame")
    track.Size            = UDim2.new(1,-28,0,10)
    track.Position        = UDim2.new(0,14,0,36)
    track.BackgroundColor3 = T.BG3
    track.BorderSizePixel = 0
    track.Parent          = row
    uc(track, 5)

    local fill = Instance.new("Frame")
    fill.Size            = UDim2.new(math.clamp((CFG[cfgKey]-mn)/(mx-mn),0,1),0,1,0)
    fill.BackgroundColor3 = T.ACC
    fill.BorderSizePixel = 0
    fill.Parent          = track
    uc(fill, 5)

    -- Thumb handle (big, touchable)
    local thumb = Instance.new("Frame")
    thumb.Size            = UDim2.new(0,20,0,20)
    thumb.BackgroundColor3 = Color3.fromRGB(210,220,255)
    thumb.BorderSizePixel = 0
    thumb.ZIndex          = 5
    thumb.Parent          = track
    uc(thumb, 10)

    local function updateThumb(ratio)
        local fillW = math.clamp(ratio, 0, 1)
        fill.Size   = UDim2.new(fillW, 0, 1, 0)
        thumb.Position = UDim2.new(fillW, -10, 0.5, -10)
    end
    updateThumb(math.clamp((CFG[cfgKey]-mn)/(mx-mn),0,1))

    local dragging3 = false
    local function handleInput(inputPos)
        local ratio = math.clamp((inputPos.X - track.AbsolutePosition.X)/track.AbsoluteSize.X, 0, 1)
        local val   = mn + math.floor(ratio*(mx-mn))
        CFG[cfgKey] = val
        updateThumb(ratio)
        valLbl.Text = disp(val)
        if onSlide then onSlide(val) end
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging3 = true
            handleInput(i.Position)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dragging3 = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if dragging3 and (
            i.UserInputType == Enum.UserInputType.MouseMovement or
            i.UserInputType == Enum.UserInputType.Touch
        ) then handleInput(i.Position) end
    end)
end

