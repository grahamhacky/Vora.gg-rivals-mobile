local function mkESP(p)
    if S.ESPDrawings[p] then return end
    local obj = {
        BoxOL  = mkDraw("Square",{Visible=false,Color=Color3.new(0,0,0),Thickness=3,Filled=false}),
        Box    = mkDraw("Square",{Visible=false,Color=BLUE,Thickness=1.4,Filled=false}),
        Name   = mkDraw("Text",  {Visible=false,Color=TXTC,Size=14,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0),Font=Drawing.Fonts.Plex}),
        Dist   = mkDraw("Text",  {Visible=false,Color=TXTD,Size=11,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0),Font=Drawing.Fonts.Plex}),
        HpBg   = mkDraw("Line",  {Visible=false,Color=Color3.new(0,0,0),Thickness=4}),
        Hp     = mkDraw("Line",  {Visible=false,Color=GREEN,Thickness=2}),
        Tracer = mkDraw("Line",  {Visible=false,Color=BLUEH,Thickness=1}),
        Skele  = {},
    }
    for i = 1, #BONES do
        obj.Skele[i] = mkDraw("Line",{Visible=false,Color=BLUE,Thickness=1})
    end
    S.ESPDrawings[p] = obj
end

local function rmESP(p)
    if not S.ESPDrawings[p] then return end
    for k, v in pairs(S.ESPDrawings[p]) do
        if type(v)=="table" then
            for _,l in ipairs(v) do safecall(function() l:Remove() end) end
        else
            safecall(function() v:Remove() end)
        end
    end
    S.ESPDrawings[p] = nil
end

local function hideESPObj(obj)
    for k, v in pairs(obj) do
        if type(v)=="table" then
            for _,l in ipairs(v) do safecall(function() l.Visible=false end) end
        else
            safecall(function() v.Visible=false end)
        end
    end
end

RunService.RenderStepped:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then mkESP(p) end
    end

    for p, obj in pairs(S.ESPDrawings) do
        local c = p.Character
        if not c or not alive(c) or not CFG.ESPEnabled then
            hideESPObj(obj); continue
        end
        local hd = c:FindFirstChild("Head")
        local rt = c:FindFirstChild("HumanoidRootPart")
        if not hd or not rt then hideESPObj(obj); continue end

        local dist = (cam.CFrame.Position - rt.Position).Magnitude
        if dist > CFG.ESPMaxDist then hideESPObj(obj); continue end

        local hScr, hOn = w2s(hd.Position + Vector3.new(0,.75,0))
        local fScr      = w2s(rt.Position  - Vector3.new(0, 3, 0))
        if not hOn then hideESPObj(obj); continue end

        local ht  = math.abs(hScr.Y - fScr.Y)
        local wd  = ht * 0.55
        local tl  = Vector2.new(hScr.X - wd/2, hScr.Y)

        obj.BoxOL.Visible  = CFG.ESPBoxes
        obj.BoxOL.Position = tl; obj.BoxOL.Size = Vector2.new(wd,ht)
        obj.Box.Visible    = CFG.ESPBoxes
        obj.Box.Position   = tl; obj.Box.Size   = Vector2.new(wd,ht)
        obj.Box.Color      = S.AimTarget == p and Color3.fromRGB(255,200,50) or BLUE

        obj.Name.Visible  = CFG.ESPNames
