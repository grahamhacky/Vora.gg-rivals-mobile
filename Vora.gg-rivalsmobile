--  SHOOT REMOTE CACHE + FIRE
-- ══════════════════════════════════════════════════════════════
local shootRemote = nil
local function findShootRemote()
    if shootRemote then return shootRemote end
    local names = {"Shoot","Fire","BulletFired","ShootEvent","FireBullet","Hit","DealDamage","Bullet"}
    for _, n in ipairs(names) do
        local r = ReplicatedStorage:FindFirstChild(n, true)
        if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
            shootRemote = r; return r
        end
    end
    local c = chr()
    if c then
        local tool = c:FindFirstChildOfClass("Tool")
        if tool then
            for _, d in ipairs(tool:GetDescendants()) do
                if d:IsA("RemoteEvent") then shootRemote = d; return d end
            end
        end
    end
end

local function fireAt(tgt)
    local bone = getBone(tgt.Character, "Head"); if not bone then return end
    local pos  = predicted(bone)
    local rem  = findShootRemote()
    if rem then
        safecall(function() rem:FireServer(pos, bone) end)
        safecall(function() rem:FireServer(bone, pos) end)
        safecall(function() rem:FireServer(pos)       end)
    end
end

