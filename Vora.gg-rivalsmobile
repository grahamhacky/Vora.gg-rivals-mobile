--  AIMBOT + RAGE LOOP
-- ══════════════════════════════════════════════════════════════
local fovCircle = mkDraw("Circle", {
    Visible=false, Color=Color3.fromRGB(40,100,255),
    Thickness=1.2, Filled=false, Radius=200, NumSides=72,
    Position=screenMid(),
})
local aimDot = mkDraw("Circle", {
    Visible=false, Color=Color3.fromRGB(80,140,255),
    Thickness=1, Filled=true, Radius=3, NumSides=16,
    Position=screenMid(),
})

RunService.Heartbeat:Connect(function()
    -- FOV circle
    fovCircle.Position = screenMid()
    fovCircle.Radius   = CFG.AimFOV
    fovCircle.Visible  = CFG.ShowFOV and (CFG.AimEnabled or CFG.SilentAim or CFG.RageEnabled)
    fovCircle.Color    = CFG.RageEnabled and Color3.fromRGB(220,40,40) or Color3.fromRGB(40,100,255)

    aimDot.Visible = false

    -- Update silent aim global target for namecall hook
    if CFG.SilentAim or CFG.RageEnabled then
        local fov = CFG.RageEnabled and CFG.RageFOV or CFG.AimFOV
        local tgt = bestTarget(fov)
        if tgt then
            local bone = getBone(tgt.Character, CFG.AimBone)
            if bone then
                silentTarget     = predicted(bone)
                silentTargetPart = bone
            end
        else
            silentTarget     = nil
            silentTargetPart = nil
        end
        silentAimActive = CFG.SilentAim or CFG.RageEnabled
    else
        silentAimActive = false
        silentTarget    = nil
    end

    -- Aimbot (auto, no key hold on mobile)
    if CFG.AimEnabled then
        local fov = CFG.RageEnabled and CFG.RageFOV or CFG.AimFOV
        local tgt = bestTarget(fov)
        if tgt then
            S.AimTarget = tgt
            local bone  = getBone(tgt.Character, CFG.AimBone)
            if bone then
                local aimPos   = predicted(bone)
                local targetCF = CFrame.new(cam.CFrame.Position, aimPos)
                cam.CFrame     = cam.CFrame:Lerp(targetCF, CFG.AimSmoothing)
                local sp, on2  = w2s(aimPos)
                aimDot.Visible  = on2
                aimDot.Position = sp
            end
        else
            S.AimTarget = nil
        end
    end

    -- Rage autoshoot
    if CFG.RageEnabled and CFG.RageAutoShoot then
        local now = tick()
        if now - S.RageLastFire >= CFG.RageFireRate/1000 then
            local tgt = bestTarget(CFG.RageFOV)
            if tgt then
                S.RageLastFire = now
                safecall(fireAt, tgt)
            end
        end
    end

    -- Triggerbot
    if CFG.RageTriggerbot then
        local cr = cam:ScreenPointToRay(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
        local rr = workspace:Raycast(cr.Origin, cr.Direction * 2000)
        if rr and rr.Instance then
            local model = rr.Instance:FindFirstAncestorOfClass("Model")
            if model then
                local p2 = Players:GetPlayerFromCharacter(model)
                if p2 and p2 ~= lp then safecall(fireAt, p2) end
            end
        end
    end

    -- No recoil
    if CFG.RageNoRecoil then
        local cf2 = cam.CFrame
        local rx, ry, rz = cf2:ToEulerAnglesYXZ()
        cam.CFrame = CFrame.fromEulerAnglesYXZ(math.clamp(rx,-1.4,1.4), ry, rz)
    end

    -- Speed
    if CFG.SpeedEnabled then
        local h = hum(); if h then h.WalkSpeed = 16 * CFG.SpeedMult end
    end
end)

