-- Up/Down buttons (right side)
local function mkUDBtn(label, posY, onDown, onUp)
    local btn = Instance.new("TextButton")
    btn.Size            = UDim2.new(0,56,0,56)
    btn.Position        = UDim2.new(1,-80,1,posY)
    btn.BackgroundColor3 = Color3.fromRGB(10,15,30)
    btn.BackgroundTransparency = 0.35
    btn.TextColor3      = T.TEXT
    btn.Text            = label
    btn.TextSize        = 22
    btn.Font            = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.Visible         = false
    btn.ZIndex          = 30
    btn.Parent          = SG
    uc(btn, 28)
    us(btn, T.ACC2, 1.5)

    btn.MouseButton1Down:Connect(function() onDown() end)
    btn.MouseButton1Up:Connect(function()   onUp()   end)
    -- Touch
    btn.TouchLongPress:Connect(function() onDown() end)
    btn.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch then onUp() end
    end)
    return btn
end

local UPBTN = mkUDBtn("↑", -JOY_OUTER_SIZE-96,
    function() S.FlyUpActive=true  end,
    function() S.FlyUpActive=false end)
local DNBTN = mkUDBtn("↓", -36,
    function() S.FlyDownActive=true  end,
    function() S.FlyDownActive=false end)

-- Joystick touch handling
local joyCenter = Vector2.new(
    JOY_BASE.Position.X.Offset + JOY_OUTER_SIZE/2,
    cam.ViewportSize.Y - 90 - JOY_OUTER_SIZE/2
)

JOY_BASE.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.Touch then
        S.FlyJoyActive = true
        S.FlyJoyId     = i
    end
end)

UserInputService.InputChanged:Connect(function(i)
    if S.FlyJoyActive and S.FlyJoyId and i == S.FlyJoyId then
        local absCen = JOY_BASE.AbsolutePosition + Vector2.new(JOY_OUTER_SIZE/2, JOY_OUTER_SIZE/2)
        local delta  = Vector2.new(i.Position.X - absCen.X, i.Position.Y - absCen.Y)
        local mag    = delta.Magnitude
        if mag > JOY_MAX_DIST then delta = delta.Unit * JOY_MAX_DIST end
        S.FlyJoyDelta  = delta / JOY_MAX_DIST  -- normalized -1..1
        JOY_KNOB.Position = UDim2.new(0, JOY_OUTER_SIZE/2 - JOY_KNOB_SIZE/2 + delta.X,
                                       0, JOY_OUTER_SIZE/2 - JOY_KNOB_SIZE/2 + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(i)
    if S.FlyJoyActive and S.FlyJoyId and i == S.FlyJoyId then
        S.FlyJoyActive = false
        S.FlyJoyId     = nil
        S.FlyJoyDelta  = Vector2.zero
        TweenService:Create(JOY_KNOB, TweenInfo.new(0.1), {
            Position = UDim2.new(0.5,-JOY_KNOB_SIZE/2, 0.5,-JOY_KNOB_SIZE/2)
        }):Play()
    end
end)

-- Show/hide joystick when fly is toggled
local function updateJoyVisibility()
    JOY_BASE.Visible = CFG.FlyEnabled
    UPBTN.Visible    = CFG.FlyEnabled
    DNBTN.Visible    = CFG.FlyEnabled
end

-- Patch fly toggle to also update joystick
local _origFlyEnable  = flyEnable
local _origFlyDisable = flyDisable
flyEnable = function()
    _origFlyEnable()
    updateJoyVisibility()
end
flyDisable = function()
    _origFlyDisable()
    updateJoyVisibility()
end

