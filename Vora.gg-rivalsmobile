-- Slider with large touch-friendly track (58px height)
local function mkSlider3(tabName, label, cfgKey, mn, mx, fmt, onSlide)
    local row = Instance.new("Frame")
    row.Size            = UDim2.new(1, 0, 0, 58)
    row.BackgroundColor3 = T.BG2
    row.BorderSizePixel = 0
