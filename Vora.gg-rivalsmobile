--  HELPERS
-- ══════════════════════════════════════════════════════════════
local function chr()  return lp.Character end
local function root() local c=chr(); return c and c:FindFirstChild("HumanoidRootPart") end
local function hum()  local c=chr(); return c and c:FindFirstChildOfClass("Humanoid") end

local function alive(c)
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function enemies()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character and alive(p.Character) then
            t[#t+1] = p
        end
    end
    return t
end

local function getBone(c, b)
    return c:FindFirstChild(b) or c:FindFirstChild("Head") or c:FindFirstChild("HumanoidRootPart")
end

local function w2s(pos)
    local v, vis = cam:WorldToViewportPoint(pos)
    return Vector2.new(v.X, v.Y), vis, v.Z
end

local function screenMid()
    return Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
end

local function distCenter(pos)
    local s, on = w2s(pos)
    if not on then return math.huge end
    return (s - screenMid()).Magnitude
end

local function bestTarget(fov)
    local best, bd = nil, math.huge
    for _, p in ipairs(enemies()) do
        local b = getBone(p.Character, CFG.AimBone)
        if b then
            local d = distCenter(b.Position)
            if d < fov and d < bd then best, bd = p, d end
        end
    end
    return best
end

local function predicted(part)
    if not CFG.AimPrediction then return part.Position end
    return part.Position + part.AssemblyLinearVelocity * CFG.AimPredictMult
end

-- Drawing (Delta supports Drawing API)
local function mkDraw(t, props)
    local ok, d = pcall(Drawing.new, t)
    if not ok then return {Visible=false, Remove=function()end} end
    for k,v in pairs(props or {}) do safecall(function() d[k]=v end) end
    return d
end

-- ══════════════════════════════════════════════════════════════
--  FLY  (touch-joystick driven)
-- ══════════════════════════════════════════════════════════════
local function flyEnable()
    local r = root(); local h = hum()
    if not r or not h then return end
    h.PlatformStand = true

    S.FlyBV = Instance.new("BodyVelocity")
    S.FlyBV.Velocity  = Vector3.zero
    S.FlyBV.MaxForce  = Vector3.new(1e5,1e5,1e5)
    S.FlyBV.Parent    = r

    S.FlyBG = Instance.new("BodyGyro")
    S.FlyBG.MaxTorque = Vector3.new(1e5,1e5,1e5)
    S.FlyBG.P         = 1e4
    S.FlyBG.CFrame    = r.CFrame
    S.FlyBG.Parent    = r

    S.FlyConn = RunService.Heartbeat:Connect(function()
        local r2 = root(); if not r2 then return end
        local cf  = cam.CFrame
        local spd = CFG.FlySpeed

        -- Joystick input → world direction
        local jd  = S.FlyJoyDelta
        local mv  = Vector3.zero
        if jd.Magnitude > 0.05 then
            mv = mv + cf.LookVector  * (-jd.Y)
            mv = mv + cf.RightVector * ( jd.X)
        end
        if S.FlyUpActive   then mv = mv + Vector3.yAxis end
        if S.FlyDownActive then mv = mv - Vector3.yAxis end

        if mv.Magnitude > 0 then mv = mv.Unit * spd end

        S.FlyBV.Velocity = S.FlyBV.Velocity:Lerp(mv, 0.2)
        S.FlyBG.CFrame   = CFrame.new(Vector3.zero, cf.LookVector)
    end)

    CFG.FlyEnabled = true
end

local function flyDisable()
    if S.FlyConn then S.FlyConn:Disconnect(); S.FlyConn = nil end
    if S.FlyBV   then S.FlyBV:Destroy();      S.FlyBV   = nil end
    if S.FlyBG   then S.FlyBG:Destroy();      S.FlyBG   = nil end
    local h = hum(); if h then h.PlatformStand = false end
    CFG.FlyEnabled = false
end

