-- ══════════════════════════════════════════════════════════════
--  MOBILE BYPASS LAYER
--  Delta doesn't have hookfunction — we use alternative methods:
--  • FireServer interception via __namecall metamethod
--  • BodyVelocity spoof via direct physics
--  • AC remote kill via getconnections when available
-- ══════════════════════════════════════════════════════════════
local bypassActive = false
local origNamecall = nil
local interceptingFire = false

local function killACRemotes()
    local rs = ReplicatedStorage
    local kw = {"anticheat","ac","detect","report","verify","sanity","flag","cheat"}
    for _, d in ipairs(rs:GetDescendants()) do
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            local ln = d.Name:lower()
            for _, k in ipairs(kw) do
                if ln:find(k) then
                    if EXE.hasGetCN then
                        local conns = getconnections(d.OnClientEvent)
                        if conns then
                            for _, c in ipairs(conns) do
                                safecall(function() c:Disable() end)
                            end
                        end
                    end
                    -- Also try to make it unreachable
                    safecall(function()
                        d.Parent = nil
                    end)
                    break
                end
            end
        end
    end
end

-- __namecall hook — works on Delta/Codex without hookfunction
-- Intercepts :FireServer calls
local silentAimActive = false
local silentTarget    = nil

local function installNamecallHook()
    if not EXE.hasGetRaw or not EXE.hasSetRO then return false end
    local mt = getrawmetatable(game)
    if not mt then return false end

    safecall(function() setreadonly(mt, false) end)

    local old_nc = mt.__namecall
    mt.__namecall = (EXE.hasNewCC and newcclosure or function(f) return f end)(function(self, ...)
        local method = getnamecallmethod and getnamecallmethod() or ""
        local args   = {...}

        if method == "FireServer" then
            -- Silent aim: redirect bullet args if active
            if (silentAimActive or (CFG and CFG.RageEnabled)) and silentTarget then
                -- Rivals fires: remote:FireServer(hitPos, hitPart, ...)
                -- Replace first Vector3 arg with our target position
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        args[i] = silentTarget
                        break
                    end
                end
                -- Replace first BasePart arg with target bone
                if silentTargetPart then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Instance" and v:IsA("BasePart") then
                            args[i] = silentTargetPart
                            break
                        end
                    end
                end
            end

            -- No spread: zero out any spread Vector3 (usually 2nd vec3 arg)
            if CFG and CFG.RageNoSpread then
                local vec3count = 0
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        vec3count += 1
                        if vec3count == 2 then
                            args[i] = Vector3.zero
                        end
                    end
                end
            end
        end

        -- AC: block outgoing reports
        if method == "FireServer" or method == "InvokeServer" then
            local n = (typeof(self) == "Instance") and self.Name:lower() or ""
            local blocked = {"anticheat","report","detect","cheatflag","kick","ban"}
            for _, k in ipairs(blocked) do
                if n:find(k) then return end -- silently drop
            end
        end

        return old_nc(self, table.unpack(args))
    end)

    safecall(function() setreadonly(mt, true) end)
    return true
end

